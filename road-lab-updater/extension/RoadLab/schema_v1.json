{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WB Pilot v1 (partial schema)",
  "type": "object",
  "required": [
    "version",
    "units",
    "roads",
    "lanes",
    "intersections",
    "crosswalks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "units": {
      "const": "m"
    },
    "roads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "intersections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "crosswalks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}